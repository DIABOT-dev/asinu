    "@tanstack/react-query": "^5.62.8",
    "clsx": "^2.1.0",
    "expo": "57.0.23",
    "expo-apple-authentication": "~57.0.2",
    "expo-asset": "~57.0.17",
    "expo-audio": "57.0.5",
